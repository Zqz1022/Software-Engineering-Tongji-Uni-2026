<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!-- Keep course dependencies separate from the user's company Maven cache. -->
  <localRepository>${maven.multiModuleProjectDirectory}/.cache/maven/repository</localRepository>
  <mirrors>
    <mirror>
      <id>course-maven-central</id>
      <name>Public Maven Central for this course project</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
