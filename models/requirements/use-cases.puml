@startuml
title 同济大学校园论坛与站内私聊系统 · 用例图（分视图）
left to right direction
skinparam defaultFontName PingFang SC
skinparam defaultFontSize 14
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 22
skinparam ranksep 42
skinparam actorBackgroundColor #EAF2FA
skinparam usecaseBackgroundColor #F4F8FC
skinparam usecaseBorderColor #355C7D
skinparam rectangleBorderColor #355C7D
skinparam frameBorderColor #90A4AE
skinparam frameBackgroundColor #FFFFFF
frame "E · VIP 购买、权益与支付服务" as Payment {
  actor "普通用户" as MemberPayment
  actor "VIP 用户" as VIPPayment
  actor "支付宝" as Alipay
  actor "微信支付" as Wechat
  rectangle "本站系统" as PaymentSystem {
    usecase "UC-20\n选择套餐并创建订单" as UC20
    usecase "UC-21\n使用支付宝充值" as UC21
    usecase "UC-22\n使用微信支付充值" as UC22
    usecase "UC-23\n使用金色昵称与主页装扮" as UC23
    usecase "UC-24\n续费及按期限使用权益" as UC24
    usecase "UC-25\n查看订单与会员期限" as UC25
    usecase "UC-26\n核验支付结果并发放权益" as UC26
  }
  MemberPayment -- UC20
  MemberPayment -- UC21
  MemberPayment -- UC22
  MemberPayment -- UC24
  MemberPayment -- UC25
  VIPPayment -- UC23
  MemberPayment <|-- VIPPayment
  UC21 -- Alipay
  UC22 -- Wechat
  UC25 -- Alipay
  UC25 -- Wechat
  UC26 -- Alipay
  UC26 -- Wechat
}

frame "D · 社区治理：管理权限" as Governance {
  actor "版主" as ModeratorGovernance
  actor "管理员" as AdminGovernance
  rectangle "本站系统" as GovernanceSystem {
    usecase "UC-16\n处理板块举报" as UC16
    usecase "UC-17\n管理平台与举报" as UC17
  }
  ModeratorGovernance -- UC16 : 仅授权板块
  AdminGovernance -- UC17 : 全站管理
}

frame "C · 普通交流：私聊与提交举报" as Chat {
  actor "普通用户" as MemberChat
  rectangle "本站系统" as ChatSystem {
    usecase "UC-10\n发起私聊" as UC10
    usecase "UC-11\n查看会话与历史" as UC11
    usecase "UC-12\n收发文本消息" as UC12
    usecase "UC-13\n查看未读与标记已读" as UC13
    usecase "UC-14\n拉黑与解除拉黑" as UC14
    usecase "UC-15\n提交举报" as UC15
    usecase "UC-18\n重试并确认消息结果" as UC18
  }
  MemberChat -- UC10
  MemberChat -- UC11
  MemberChat -- UC12
  MemberChat -- UC13
  MemberChat -- UC14
  MemberChat -- UC15
  MemberChat -- UC18
}

frame "B · 普通交流：公开论坛" as Forum {
  actor "普通用户" as MemberForum
  rectangle "本站系统" as ForumSystem {
    usecase "UC-02\n维护个人资料" as UC02
    usecase "UC-04\n发布帖子" as UC04
    usecase "UC-06\n发表评论" as UC06
    usecase "UC-07\n编辑本人帖子" as UC07
    usecase "UC-08\n删除本人内容" as UC08
    usecase "UC-09\n搜索与筛选帖子" as UC09
  }
  MemberForum -- UC02
  MemberForum -- UC04
  MemberForum -- UC06
  MemberForum -- UC07
  MemberForum -- UC08
  MemberForum -- UC09
}

frame "A · 登录与帖子浏览" as Access {
  actor "未登录使用者\n（会话状态）" as BeforeLogin
  actor "普通用户" as MemberAccess
  actor "VIP 用户" as VIPAccess
  actor "版主" as ModeratorAccess
  actor "管理员" as AdminAccess
  actor "QQ 登录服务" as QQLogin
  actor "微信登录服务" as WechatLogin
  rectangle "本站系统" as AccessSystem {
    usecase "UC-01\n使用 QQ 登录" as UC01
    usecase "UC-03\n浏览板块帖子" as UC03
    usecase "UC-05\n查看帖子详情" as UC05
    usecase "UC-19\n使用微信登录" as UC19
  }
  BeforeLogin -- UC01
  BeforeLogin -- UC19
  UC01 -- QQLogin
  UC19 -- WechatLogin
  MemberAccess -[#1565C0]- UC03 : 浏览
  MemberAccess -[#1565C0]- UC05 : 查看
  MemberAccess <|-- VIPAccess
  MemberAccess <|-- ModeratorAccess
  MemberAccess <|-- AdminAccess
}
legend bottom
  本图按功能分视图；每个“本站系统”均指同一系统，同名参与者为同一角色。
  四类业务角色：普通用户、VIP 用户、版主、管理员；未登录使用者仅表示会话状态。
  QQ 或微信首次有效登录自动创建普通账号，登录后即可浏览、发帖、评论和私聊。
  空心三角指向普通用户：VIP、版主、管理员具备普通能力，普通用户不反向获得其专属权限。
  普通用户提交举报（UC-15）；版主处理授权板块举报（UC-16）；管理员执行全站管理（UC-17）。
  QQ 登录、微信登录、支付宝、微信支付为四个外部集成；微信登录与微信支付分别处理。
  登录不授予 VIP；管理授权与会员状态独立；支付平台可主动触发 UC-26。
endlegend
@enduml
